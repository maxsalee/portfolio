# Copy this file to ".env" and fill in your own key.
# The .env file is git-ignored; never commit it and never paste the key
# into index.html or any file under js/. The key is read by server.js
# (local preview) and by netlify/functions/chat.js (the deployed site).

# Get a key at https://openrouter.ai/keys  (starts with sk-or-v1-)
OPENROUTER_API_KEY=

# Any model from https://openrouter.ai/models works. ":free" models cost
# nothing but are rate-limited more aggressively.
CHAT_MODEL=nvidia/nemotron-3.5-lightning:free

# Optional: used in the HTTP-Referer header OpenRouter shows on your dashboard.
SITE_URL=https://maxsalee-portfolio.netlify.app/

# Optional: set to 1 to ask the model to "think" before answering. Slower and
# not needed for CV questions; left off by default.
CHAT_REASONING=
